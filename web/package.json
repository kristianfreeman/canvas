  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "^1.4.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/react-reconciler": "^0.34.0",
